# ==============================================================================
# PRISM DEPLOYMENT ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env for local development or configure these variables in:
# - Render Dashboard (Environment tab for Backend Web Service)
# - Vercel Dashboard (Project Settings -> Environment Variables for Frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Local)
# ------------------------------------------------------------------------------
# Local development default:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pofa_dev

# Supabase Production Connection String:
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# NOTE: Use the Connection Pooler (port 6543, transaction mode) on Render because
# Render outbound requires IPv4 (Supabase direct db.<ref>.supabase.co is IPv6-only).
# FORMAT:
# DATABASE_URL=postgresql+psycopg2://postgres.<project_ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# CRITICAL: If your password contains special characters (e.g. '@', ':', '#', '%', '&'),
# they MUST be URL-encoded (e.g. '@' -> '%40', '#' -> '%23'). PRISM backend automatically
# handles password quoting, but encoding them properly is recommended.

# Optional dedicated migration identity for schema DDL (defaults to DATABASE_URL if unset):
# MIGRATION_DATABASE_URL=postgresql+psycopg2://postgres.<project_ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Automatically apply database migrations on container startup (alembic upgrade head):
RUN_MIGRATIONS=true

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & SECURITY
# ------------------------------------------------------------------------------
# Environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Dynamic server port (Render automatically provides PORT):
PORT=8000

# Backend secret key for JWT signatures (must be at least 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# CORS Allowlist: Comma-separated list of allowed frontend origins.
# Use '*' for local development only. For production, specify your Vercel domains:
# CORS_ALLOW_ORIGINS=https://prism-app.vercel.app,https://yourdomain.com
CORS_ALLOW_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & OIDC (Supabase Auth Integration)
# ------------------------------------------------------------------------------
# Auth mode: 'development' allows anonymous access; 'enforcing' requires valid credentials (production)
AUTH_MODE=development

# Development bearer tokens (dev-user-*, dev-client-*): Set to false in production
AUTH_DEV_TOKENS_ENABLED=true

# Stage 02 trusted OIDC identity verification via Supabase Auth:
AUTH_OIDC_ENABLED=true
# Obtain project URL from Supabase Dashboard -> Project Settings -> API:
AUTH_OIDC_ISSUER=https://<project-ref>.supabase.co/auth/v1
AUTH_OIDC_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_OIDC_AUDIENCE=authenticated
AUTH_OIDC_IDENTITY_PROVIDER=supabase
AUTH_OIDC_ALGORITHMS=ES256,RS256
AUTH_OIDC_JWKS_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (Supabase Storage / S3 / MinIO)
# ------------------------------------------------------------------------------
# Supabase Storage S3-Compatible API:
# Endpoint format: https://<project-ref>.supabase.co/storage/v1/s3
# Obtain S3 Access Keys from: Supabase Dashboard -> Project Settings -> Storage -> S3 Access Keys
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_USE_SSL=true
S3_ACCESS_KEY=your_supabase_s3_access_key_id
S3_SECRET_KEY=your_supabase_s3_secret_access_key

# Buckets (Create these buckets in Supabase Dashboard -> Storage):
S3_QUARANTINE_BUCKET=pofa-quarantine
S3_EVIDENCE_BUCKET=pofa-evidence
MAX_UPLOAD_SIZE=10485760

# Set to true only if backend web process must refuse to start without storage connectivity:
STORAGE_REQUIRED=false

# Local MinIO alternative (only for local docker development):
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_USE_SSL=false

# ------------------------------------------------------------------------------
# 5. REDIS CONFIGURATION (Upstash Redis / External Managed Redis)
# ------------------------------------------------------------------------------
# For production, obtain TLS-enabled Redis URL from Upstash Console -> Details -> Connect:
# Example: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Set to true if Redis is mandatory for web service readiness:
REDIS_REQUIRED=false

ANALYSIS_QUEUE_NAME=pofa:analysis:jobs
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_ABANDONED_TIMEOUT_SECONDS=300
ANALYSIS_RETRY_BACKOFF_BASE_SECONDS=1.0
ANALYSIS_RETRY_BACKOFF_MAX_SECONDS=60.0
ANALYSIS_SHUTDOWN_POLL_SECONDS=0.5
ANALYSIS_REDIS_SOCKET_TIMEOUT_SECONDS=30.0
ANALYSIS_REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=10.0
ANALYSIS_REDIS_HEALTH_CHECK_INTERVAL_SECONDS=15.0
ANALYSIS_DEQUEUE_BLOCK_SECONDS=5

# ------------------------------------------------------------------------------
# 6. VISION & EMBEDDING PIPELINE
# ------------------------------------------------------------------------------
PHASH_MAX_HAMMING_DISTANCE=8
EMBEDDING_MODEL_NAME=openai/clip-vit-base-patch32
EMBEDDING_DIMENSION=512
EMBEDDING_TOP_K=10

VISION_ENABLED=true
VISION_MODEL_NAME=yolo11n.pt
VISION_CONF_THRESHOLD=0.25
VISION_IOU_THRESHOLD=0.45
VISION_MAX_DETECTIONS=100
VISION_DEVICE=auto
VISION_IMGSZ=640

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & METRICS
# ------------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
OBSERVABILITY_LOG_FORMAT=json
OBSERVABILITY_REDACT_SENSITIVE=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=prism-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATE=0.1

# ==============================================================================
# 8. FRONTEND VARIABLES (Configure in Vercel)
# ==============================================================================
# VITE_API_BASE_URL=https://prism-backend.onrender.com
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
# VITE_APP_NAME=PRISM Evidence Integrity
# VITE_ENVIRONMENT=production
